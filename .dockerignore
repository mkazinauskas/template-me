node_modules
.next
.git
.vercel
*.tsbuildinfo
npm-debug.log*
.DS_Store
# Never bake host secrets into the build context/image — Docker Compose
# passes what the containers need via env_file/build args instead.
.env*

# Playwright output (see e2e/, playwright.config.ts) — excluded so that
# running the E2E suite against `tilt up` doesn't itself trigger a rebuild:
# these directories change on every run but aren't part of the app image.
/test-results/
/playwright-report/
/playwright/.cache/
