# Dev image for the `app` service in docker-compose.yml. Unlike the
# production Dockerfile, this runs `next dev` directly instead of building a
# standalone bundle. Under `tilt up`, Tilt live-syncs source changes into the
# running container (see Tiltfile) and Next's own Turbopack watcher picks
# them up and refreshes the browser automatically; under plain `docker
# compose up` you get the same dev server without the live-sync.
FROM node:24-alpine
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

EXPOSE 3000
CMD ["npx", "next", "dev"]
