# Dev image for `tilt up`. Unlike the production Dockerfile, this runs
# `next dev` directly instead of building a standalone bundle — Tilt live-syncs
# source changes into the running container (see Tiltfile) and Next's own
# Turbopack watcher picks them up and refreshes the browser automatically.
FROM node:22-alpine
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

EXPOSE 3000
CMD ["npx", "next", "dev"]
